# SmartFeeder EMS - Environment Configuration Template
# Copy this file to .env and configure appropriate values

# Flask Secret Key for Session Signing
SECRET_KEY=your-random-secret-key-here-minimum-32-chars

# Administrator Credentials (Controlled only by administrator / backend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Server Settings
PORT=8000
FLASK_ENV=development
SESSION_COOKIE_SECURE=False
